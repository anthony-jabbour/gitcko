---
source: crates/gitcko-config/tests/golden.rs
expression: "format!(\"# repo\\n{}\\n# user\\n{}\", repo.explain(), user.explain())"
---
# repo
auto_approve.enabled = false  <- default
auto_approve.risk_ceiling = "low"  <- default
auto_review = ["open"]  <- default
check_run = true  <- default
comment_types = ["logic"]  <- packages/api/.gitcko/config.toml:1
context.files[0] = {"path":"docs/architecture.md"}  <- .gitcko/config.toml:23
context.files[1] = {"path":"openapi.yaml"}  <- packages/api/.gitcko/config.toml:14
disabled_rules = ["no-console"]  <- packages/api/.gitcko/config.toml:3
exclude_authors = ["dependabot[bot]","renovate[bot]"]  <- default
fix_links = true  <- default
hide_footer = false  <- default
ignore = ["*.lock","package-lock.json","pnpm-lock.yaml","yarn.lock","go.sum","vendor/","dist/","*.min.*"]  <- default
instructions = "Root instructions.\n\nPackages instructions.\n\nAPI instructions."  <- .gitcko/config.toml:4, packages/.gitcko/config.toml:2, packages/api/.gitcko/config.toml:2
review_drafts = false  <- default
rules[0] = {"id":"errors","rule":"Handle every error.","severity":"P1"}  <- .gitcko/config.toml:15
rules[1] = {"rule":"A rule with no id can't be disabled below."}  <- .gitcko/config.toml:20
rules[2] = {"id":"api-auth","rule":"Every route checks auth.","scope":["src/**"],"severity":"P1"}  <- packages/api/.gitcko/config.toml:8
schema_version = 1  <- .gitcko/config.toml:1
skip_auto_review = false  <- default
strictness = 1  <- packages/.gitcko/config.toml:1
summary.diagram.collapsible = true  <- default
summary.diagram.default_open = false  <- default
summary.diagram.included = true  <- default
summary.files_table.collapsible = true  <- default
summary.files_table.default_open = false  <- default
summary.files_table.included = true  <- default
summary.overview.collapsible = false  <- packages/api/.gitcko/config.toml:6
summary.overview.default_open = true  <- default
summary.overview.included = true  <- .gitcko/config.toml:7
summary.score.included = true  <- default
summary.security.included = true  <- default
summary_only = false  <- default
update_description = false  <- default
rules.md = "Root free-form rules."  <- .gitcko/rules.md

# user
api_url = "https://api.gitcko.dev"  <- default
review.context = 15  <- default
review.layout = "comments"  <- default
review.output = "auto"  <- default
telemetry = false  <- default
web_url = "https://app.gitcko.dev"  <- default
