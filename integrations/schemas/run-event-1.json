{
  "$id": "https://gitcko.dev/schema/run-event-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunEvent",
  "description": "One event in a run's stream. New event types can appear without a version bump, so\nreaders must accept a `type` they don't know.",
  "type": "object",
  "properties": {
    "at": {
      "description": "RFC 3339 timestamp in UTC.",
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "description": "Position in the run's stream, starting at 1.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/RunLifecycle"
        },
        "to": {
          "$ref": "#/$defs/RunLifecycle"
        },
        "type": {
          "type": "string",
          "const": "lifecycle.changed"
        }
      },
      "required": [
        "type",
        "from",
        "to"
      ]
    },
    {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "step.started"
        }
      },
      "required": [
        "type",
        "step"
      ]
    },
    {
      "type": "object",
      "properties": {
        "counts": {
          "description": "Bounded counts such as files, symbols or hypotheses.",
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "default": {}
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "step": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "step.completed"
        }
      },
      "required": [
        "type",
        "step",
        "outcome",
        "duration_ms"
      ]
    },
    {
      "description": "One model call attempt, from the router's call record (MODEL_ROUTING §12). Values\nare names, codes and numbers only: never prompt or response text, keys or hosts.",
      "type": "object",
      "properties": {
        "attempt": {
          "description": "1 for the first try.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "binding": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "cost_usd": {
          "description": "`null` when the provider doesn't report cost.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "fallback_from": {
          "description": "The binding this call fell back from, if it was a fallback.",
          "type": [
            "string",
            "null"
          ]
        },
        "fallback_reason": {
          "description": "A fixed code such as `primary_failed` or `circuit_open`, set with `fallback_from`.",
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "description": "The model family, which judge independence and inversion compare.",
          "type": "string"
        },
        "first_token_ms": {
          "description": "`null` when no token arrived.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "input_tokens": {
          "description": "`null` when the provider didn't report it; never 0 for unknown.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "inversion": {
          "description": "The author-family inversion decision, for roles that apply it.",
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "policy": {
          "description": "The routing policy as `id@version`.",
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/PromptRef"
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "step": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "model_call.completed"
        }
      },
      "required": [
        "type",
        "role",
        "binding",
        "class",
        "provider",
        "family",
        "policy",
        "prompt",
        "attempt",
        "duration_ms",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "binding": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/BreakerState"
        },
        "type": {
          "type": "string",
          "const": "breaker.changed"
        }
      },
      "required": [
        "type",
        "binding",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cap": {
          "type": "number",
          "format": "double"
        },
        "limit": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "type": {
          "type": "string",
          "const": "budget.warning"
        },
        "used": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "type",
        "limit",
        "used",
        "cap"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cap": {
          "type": "number",
          "format": "double"
        },
        "limit": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "type": {
          "type": "string",
          "const": "budget.exhausted"
        },
        "used": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "type",
        "limit",
        "used",
        "cap"
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string"
        },
        "stale_rejected": {
          "description": "True when publishing was refused because a newer head exists.",
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/PublishTarget"
        },
        "type": {
          "type": "string",
          "const": "publish.completed"
        }
      },
      "required": [
        "type",
        "target",
        "outcome",
        "stale_rejected"
      ]
    }
  ],
  "required": [
    "run_id",
    "seq",
    "at"
  ],
  "$defs": {
    "BreakerState": {
      "description": "A circuit breaker for one model binding: `open` stops calls to a failing provider\nso a run fails fast or falls back instead of waiting on timeouts; `half_open` lets\none trial call through to see whether it has recovered.",
      "type": "string",
      "enum": [
        "closed",
        "open",
        "half_open"
      ]
    },
    "BudgetLimit": {
      "description": "Which of the run's budgets (MODEL_ROUTING §6) a warning or stop is about.",
      "type": "string",
      "enum": [
        "tokens",
        "cost",
        "wall_clock"
      ]
    },
    "PromptRef": {
      "description": "A versioned prompt: changing its text changes its version, and with it every\nrecorded replay keyed on it (DEVELOPMENT §6).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "PublishTarget": {
      "description": "Where a result was posted on the code host: the summary, inline comments or the\ncheck run.",
      "type": "string",
      "enum": [
        "summary",
        "inline",
        "check"
      ]
    },
    "RunLifecycle": {
      "description": "The stage a run is in, as shown to the user while it works. The last five are\nterminal: a run ends in exactly one of them.",
      "type": "string",
      "enum": [
        "queued",
        "indexing",
        "reviewing_files",
        "generating_summary",
        "completed",
        "failed",
        "canceled",
        "superseded",
        "skipped"
      ]
    }
  }
}
