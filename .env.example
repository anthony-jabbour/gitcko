# Keys for `cargo xtask` live runs. To use it:
#
#   cp .env.example .env
#   chmod 600 .env
#
# then fill in .env. It is git-ignored and the leak guard refuses it, so a real key can't
# be committed by accident. Leave this template empty: real values never go here, nor in
# evals/models.toml or any other tracked file.
#
# A variable already set in your shell wins over .env. Only `cargo xtask` reads this file;
# the gitcko binary never loads a .env, because the repository under review could plant one.

# Use a dedicated key with a spending limit, created for this repository alone.
OPENROUTER_API_KEY=

# Only for an Ollama that isn't at the default http://127.0.0.1:11434.
# OLLAMA_HOST=
